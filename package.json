{
    "name": "yii2-framework-docs",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "prebuild": "node scripts/sync.mjs && php tools/bin/reference --baseline tools/baseline.json",
        "build": "astro build",
        "postbuild": "node scripts/check-site.mjs && node scripts/llms-sizes.mjs",
        "preview": "astro preview",
        "reference": "php tools/bin/reference",
        "astro": "astro",
        "descriptions": "node scripts/add-descriptions.mjs",
        "sync": "node scripts/sync.mjs",
        "sync:local": "node scripts/sync.mjs --local",
        "test": "node --test scripts/*.test.mjs plugins/*.test.mjs",
        "test:plugins": "node --test plugins/*.test.mjs",
        "test:sync": "node --test scripts/sync.test.mjs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.2",
        "@astrojs/mdx": "8.0.3",
        "@astrojs/starlight": "0.42.6",
        "astro": "7.3.8",
        "astro-og-canvas": "0.13.2",
        "github-slugger": "2.0.0",
        "hast-util-select": "6.0.4",
        "rehype-parse": "9.0.1",
        "rehype-remark": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-stringify": "11.0.0",
        "sharp": "0.35.5",
        "starlight-llm-actions": "0.13.0",
        "starlight-llms-txt": "0.12.0",
        "unified": "11.0.5",
        "unist-util-remove": "4.0.0",
        "unist-util-visit": "5.1.0"
    }
}
