{
    "name": "yii2-framework-docs",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "prebuild": "node scripts/sync.mjs && php tools/bin/reference --baseline tools/baseline.json && php tools/bin/demos --strict",
        "build": "astro build",
        "postbuild": "node scripts/check-site.mjs && node scripts/llms-sizes.mjs && node scripts/check-skill-installation.mjs",
        "preview": "astro preview",
        "reference": "php tools/bin/reference",
        "astro": "astro",
        "demos": "php tools/bin/demos",
        "descriptions": "node scripts/add-descriptions.mjs",
        "catalog:import": "node scripts/catalog-import.mjs",
        "catalog:refresh": "node scripts/catalog-refresh.mjs",
        "catalog:check": "node scripts/catalog-check.mjs",
        "sync": "node scripts/sync.mjs",
        "sync:local": "node scripts/sync.mjs --local",
        "test": "node --test scripts/*.test.mjs plugins/*.test.mjs",
        "test:plugins": "node --test plugins/*.test.mjs",
        "test:sync": "node --test scripts/sync.test.mjs",
        "check:skills": "node scripts/check-skill-installation.mjs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.2",
        "@astrojs/mdx": "8.1.0",
        "@astrojs/starlight": "0.42.6",
        "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
        "astro": "7.4.0",
        "astro-og-canvas": "0.13.2",
        "github-slugger": "2.0.0",
        "hast-util-select": "6.0.4",
        "rehype-parse": "9.0.1",
        "rehype-remark": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-stringify": "11.0.0",
        "sharp": "0.35.5",
        "starlight-llm-actions": "0.13.0",
        "starlight-llms-txt": "0.12.0",
        "unified": "11.0.5",
        "unist-util-remove": "4.0.0",
        "unist-util-visit": "5.1.0"
    },
    "devDependencies": {
        "bootstrap": "6.0.0-alpha.1",
        "cropperjs": "2.3.0",
        "filepond": "4.32.12",
        "filepond-plugin-file-encode": "2.1.14",
        "filepond-plugin-file-poster": "2.5.2",
        "filepond-plugin-file-rename": "1.1.8",
        "filepond-plugin-file-validate-size": "2.2.8",
        "filepond-plugin-file-validate-type": "1.2.9",
        "filepond-plugin-image-crop": "2.0.6",
        "filepond-plugin-image-edit": "1.6.3",
        "filepond-plugin-image-exif-orientation": "1.0.11",
        "filepond-plugin-image-preview": "4.6.12",
        "filepond-plugin-image-transform": "3.8.8",
        "filepond-plugin-pdf-preview": "1.0.4"
    }
}
