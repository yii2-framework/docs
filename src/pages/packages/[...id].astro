---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { documentationTarget, ecosystemLabels, familyLabels, maintainerLink, packages, relationshipLabels, withBase } from "../../lib/catalog.mjs";
import { hostingFor, loadHosting } from "../../lib/hosting.mjs";
import "../../styles/portal.css";
import "../../styles/catalog.css";
import "../../styles/directory.css";

export function getStaticPaths() {
  return packages.map((pkg) => ({ params: { id: pkg.id }, props: { pkg } }));
}

const { pkg } = Astro.props;
const base = import.meta.env.BASE_URL;
const markdownUrl = withBase(`/packages/${pkg.id}/index.md`, base);
const hosting = hostingFor(pkg, loadHosting());
const target = documentationTarget(pkg, hosting);
const hosted = target.kind === "hosted";
// Ecosystem pills name the frameworks; the requirements below show PHP.
const pills = pkg.ecosystems.filter((ecosystem) => ecosystem !== "php");
const pageMarkdown = (url) => withBase(`${url}index.md`, base);
const rows = hosted
  ? [
      ...hosting.pages.map((page) => ({
        label: hosting.demos && page.slug === "examples" ? `${page.title} (live demos)` : page.title,
        url: withBase(page.url, base),
        markdown: pageMarkdown(page.url),
      })),
      ...(hosting.referenceUrl ? [{ label: "API reference", url: withBase(hosting.referenceUrl, base), markdown: pageMarkdown(hosting.referenceUrl) }] : []),
    ]
  : [];
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: pkg.name,
    description: pkg.summary,
    template: "splash",
    tableOfContents: false,
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
    head: [{ tag: "link", attrs: { rel: "alternate", type: "text/markdown", href: markdownUrl } }],
  }}
>
  <article class="portal-container portal-package">
    <nav class="catalog-breadcrumb" aria-label="Breadcrumb"><a href={withBase("/packages/", base)}>Packages</a><span aria-hidden="true">/</span><span>{familyLabels[pkg.family]}</span></nav>
    <div class="package-introduction">
      <p class="catalog-package-id">{pkg.id}</p>
      <p class="package-summary">{pkg.summary}</p>
      {pills.length > 0 && <ul class="catalog-tags" aria-label="Ecosystems">{pills.map((ecosystem) => <li>{ecosystemLabels[ecosystem]}</li>)}</ul>}
      <div class="portal-actions">
        {hosted && <a class="portal-button" href={withBase(target.url, base)}>{target.label}</a>}
        {target.kind === "external" && <a class="portal-button" href={target.url} rel="noopener">{target.label} (leaves this site)</a>}
        <a class="portal-button portal-button-secondary" href={pkg.repository}>Repository</a>
        <a class="package-markdown" href={markdownUrl}>Read as Markdown</a>
      </div>
    </div>

    <div class="package-layout">
      <div class="package-details">
        {hosted ? (
          <section class="package-section" aria-labelledby="documentation">
            <h2 id="documentation">Documentation on this site</h2>
            <ul class="directory-pages">
              {rows.map((row) => (
                <li>
                  <a href={row.url}>{row.label}</a>
                  <a class="directory-markdown" href={row.markdown}>Markdown<span class="sr-only"> version of {row.label}</span></a>
                </li>
              ))}
              {hosting.skillUrl && (
                <li>
                  <a href={withBase(hosting.skillUrl, base)}>Agent skill <code>{hosting.skill}</code></a>
                </li>
              )}
            </ul>
          </section>
        ) : (
          <section class="package-section" aria-labelledby="documentation">
            <h2 id="documentation">Documentation</h2>
            {target.kind === "external" ? (
              <>
                <p>The guide is maintained in the project's repository.</p>
                <p><a href={target.url} rel="noopener">{target.label} (leaves this site)</a></p>
              </>
            ) : (
              <p>The guide is not yet published on this site.</p>
            )}
          </section>
        )}

        <section class="package-section" aria-labelledby="requirements">
          <h2 id="requirements">Requirements</h2>
          <p>As declared in the package's <code>composer.json</code> at the commit below. Check the guide before adding it to an application.</p>
          <dl class="package-requirements">
            <div><dt>PHP</dt><dd><code>{pkg.php}</code><a href={pkg.provenance.url}>composer.json at this commit<span class="sr-only"> (PHP requirement)</span></a></dd></div>
            {pkg.compatibility.filter((entry) => entry.ecosystem !== "php").map((entry) => <div>
              <dt>{ecosystemLabels[entry.ecosystem]}</dt>
              <dd><code>{entry.constraint}</code><a href={entry.evidence}>composer.json at this commit<span class="sr-only"> ({ecosystemLabels[entry.ecosystem]} requirement)</span></a></dd>
            </div>)}
          </dl>
        </section>

        <section class="package-section" aria-labelledby="checked-version">
          <h2 id="checked-version">Which version was checked</h2>
          {pkg.provenance.kind === "source" ? (
            <p>These requirements were read from <code>{pkg.provenance.ref}</code> at the commit below. This entry does not name a released version.</p>
          ) : (
            <p>This record describes the linked release reference. It does not claim that this is the newest release.</p>
          )}
          <dl class="package-provenance">
            <div><dt>Branch or tag</dt><dd>{pkg.provenance.ref}</dd></div>
            <div><dt>Commit</dt><dd><a href={pkg.provenance.url}><code>{pkg.provenance.commit}</code></a></dd></div>
            <div><dt>Last checked</dt><dd><time datetime={pkg.provenance.reviewedAt}>{pkg.provenance.reviewedAt}</time></dd></div>
          </dl>
        </section>
      </div>

      <aside class="package-facts" aria-labelledby="package-details">
        <h2 id="package-details">Details</h2>
        <dl>
          <div><dt>Collection</dt><dd>{familyLabels[pkg.family]}</dd></div>
          <div><dt>Type</dt><dd class="package-kind">{pkg.kind}</dd></div>
          <div>
            <dt>Maintained by</dt>
            <dd>
              <a href={maintainerLink(pkg).url}>{maintainerLink(pkg).label}</a>
              <span class="directory-relationship">{relationshipLabels[pkg.relationship]}</span>
              <a class="package-evidence" href={pkg.relationshipEvidence}>View evidence</a>
            </dd>
          </div>
          <div><dt>License</dt><dd>{pkg.license}</dd></div>
        </dl>
        {pkg.relationship === "community" && <p class="catalog-note">This package is maintained independently. Its listing does not imply an official Yii affiliation or support agreement with this site.</p>}
      </aside>
    </div>

    <nav class="directory-more" aria-label="Related pages">
      <ul>
        <li><a href={`${withBase("/packages/", base)}?family=${encodeURIComponent(pkg.family)}`}>More from {familyLabels[pkg.family]}</a></li>
        {hosted && <li><a href={withBase("/documentation/", base)}>All documentation on this site</a></li>}
      </ul>
    </nav>

    <p class="directory-contribute">Spotted a mistake? <a href={withBase("/contribute/", base)}>Propose a correction</a>.</p>
  </article>
</StarlightPage>
