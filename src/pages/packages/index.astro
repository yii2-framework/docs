---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Catalog from "../../components/portal/Catalog.astro";
import { packages, withBase } from "../../lib/catalog.mjs";
import { loadHosting } from "../../lib/hosting.mjs";

const markdownUrl = withBase("/packages/index.md", import.meta.env.BASE_URL);
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: "Packages",
    description: "Reviewed Yii2, Yii3 and PHP packages with declared requirements, maintainers and links to their guides.",
    template: "splash",
    tableOfContents: false,
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
    head: [{ tag: "link", attrs: { rel: "alternate", type: "text/markdown", href: markdownUrl } }],
  }}
>
  <Catalog packages={packages} hosting={loadHosting()} />
</StarlightPage>
