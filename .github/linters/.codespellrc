[codespell]
skip = .git,tools/output/*,./tools/output/*,internal/*,./internal/*,.claude/*,./.claude/*,*.lock,package-lock.json,public/reference/*,./public/reference/*,public/demos/*,./public/demos/*,src/content/docs/api/*,./src/content/docs/api/*,src/content/docs/extensions/*,./src/content/docs/extensions/*,./package-lock.json,*/package-lock.json,node_modules,vendor,dist,./dist/*,dist/*,./src/content/docs/guide/*,./src/content/docs/internals/*,src/content/docs/guide/*,src/content/docs/internals/*,./src/content/docs/*/guide/*,./src/content/docs/*/internals/*,src/content/docs/*/guide/*,src/content/docs/*/internals/*,*/src/content/docs/guide/*,*/src/content/docs/internals/*,*/src/content/docs/*/guide/*,*/src/content/docs/*/internals/*
ignore-words-list = nd,nin,januar,boxs,wither
