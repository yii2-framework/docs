[codespell]
skip = .git,*.lock,package-lock.json,./package-lock.json,*/package-lock.json,node_modules,vendor,dist,./dist/*,dist/*,./src/content/docs/guide/*,./src/content/docs/internals/*,src/content/docs/guide/*,src/content/docs/internals/*,./src/content/docs/*/guide/*,./src/content/docs/*/internals/*,src/content/docs/*/guide/*,src/content/docs/*/internals/*,*/src/content/docs/guide/*,*/src/content/docs/internals/*,*/src/content/docs/*/guide/*,*/src/content/docs/*/internals/*
ignore-words-list = nd,nin,januar,boxs
