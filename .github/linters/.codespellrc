[codespell]
skip = .git,node_modules,vendor,dist,dist/**,./dist/**,package-lock.json,**/package-lock.json,./src/content/docs/*/guide/*,./src/content/docs/*/internals/*,src/content/docs/*/guide/*,src/content/docs/*/internals/*,./src/content/docs/**/guide/*,./src/content/docs/**/internals/*,src/content/docs/**/guide/*,src/content/docs/**/internals/*
ignore-words-list = nd,nin,januar,boxs
